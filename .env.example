# ===================================================
# IQOO NavX — Backend Environment Configuration Example
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Platform (Database & Auth)
# URL of your Supabase project (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Public anon/publishable key for client tokens
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
# SERVER ONLY: Service role key for admin tasks & RLS bypass where safe
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Maps / Routing Platform (Server-side keys)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here

# Google Gemini AI Assistant (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
