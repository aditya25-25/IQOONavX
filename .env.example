# ===================================================
# IQOO NavX — Full-Stack Environment Configuration
# ===================================================

# Server Configuration (Backend)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ===================================================
# Frontend Configuration (Vite Public Variables)
# ===================================================
VITE_API_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ===================================================
# Supabase Platform (Backend Database & Auth)
# ===================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_SERVER_SECRET_KEY

# ===================================================
# Routing (OSRM & Matrix Engine)
# ===================================================
OSRM_BASE_URL=https://router.project-osrm.org

# ===================================================
# OpenStreetMap / Geocoding / Place Search
# ===================================================
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ===================================================
# IP Geolocation (Optional)
# ===================================================
IPSTACK_API_KEY=YOUR_IPSTACK_API_KEY

# ===================================================
# Google APIs (Optional - Fallbacks active)
# ===================================================
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# ===================================================
# Google Gemini AI Assistant (Optional)
# ===================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ===================================================
# Rate Limiting
# ===================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
